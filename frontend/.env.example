# URL backend API.
# Local dev: để trống hoặc dùng dòng dưới — lib/api.ts tự fallback về
# http://127.0.0.1:8000 nếu biến này không được set.
# Production (Vercel): set giá trị này trong Vercel Dashboard →
# Project Settings → Environment Variables, KHÔNG commit URL thật vào đây.
# PHẢI có prefix NEXT_PUBLIC_ — biến không có prefix này sẽ không lộ ra
# browser bundle, khiến fetch luôn rơi về fallback local dù đã set nhầm chỗ.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
