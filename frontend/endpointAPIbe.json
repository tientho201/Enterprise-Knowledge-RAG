{
  "baseUrl": "http://localhost:8000",
  "apiPrefix": "/api/v1",
  "auth": {
    "header": "Authorization: Bearer <access_token>"
  },
  "endpoints": {
    "auth": {
      "register": {
        "method": "POST",
        "path": "/api/v1/auth/register",
        "auth": false,
        "statusCode": 201,
        "request": {
          "body": {
            "email": "string (EmailStr)",
            "password": "string (min: 8, max: 100)",
            "full_name": "string | null"
          }
        },
        "response": {
          "id": "string (uuid)",
          "email": "string",
          "full_name": "string | null",
          "role": "user | admin",
          "is_active": "boolean"
        }
      },
      "login": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "auth": false,
        "statusCode": 200,
        "request": {
          "body": {
            "email": "string",
            "password": "string"
          }
        },
        "response": {
          "access_token": "string (JWT)",
          "refresh_token": "string (JWT)",
          "token_type": "bearer"
        }
      },
      "refresh": {
        "method": "POST",
        "path": "/api/v1/auth/refresh",
        "auth": false,
        "statusCode": 200,
        "request": {
          "body": {
            "refresh_token": "string"
          }
        },
        "response": {
          "access_token": "string (JWT)",
          "refresh_token": "string (JWT)",
          "token_type": "bearer"
        }
      },
      "me": {
        "method": "GET",
        "path": "/api/v1/auth/me",
        "auth": true,
        "statusCode": 200,
        "response": {
          "id": "string (uuid)",
          "email": "string",
          "full_name": "string | null",
          "role": "user | admin",
          "is_active": "boolean"
        }
      }
    },
    "chat": {
      "sendMessage": {
        "method": "POST",
        "path": "/api/v1/chat",
        "auth": true,
        "statusCode": 200,
        "request": {
          "body": {
            "message": "string",
            "conversation_id": "string (uuid) | null",
            "search_tool": "boolean | null"
          }
        },
        "response": {
          "conversation_id": "string (uuid)",
          "message": {
            "id": "string (uuid)",
            "role": "user | assistant",
            "content": "string",
            "created_at": "ISO8601 datetime",
            "citations": [
              {
                "chunk_id": "string",
                "document_id": "string",
                "document_name": "string",
                "page_number": "number | null",
                "section_title": "string | null",
                "source_link": "string | null",
                "content_snippet": "string"
              }
            ]
          }
        }
      },
      "getHistory": {
        "method": "GET",
        "path": "/api/v1/chat/history",
        "auth": true,
        "statusCode": 200,
        "response": [
          {
            "id": "string (uuid)",
            "title": "string | null",
            "created_at": "ISO8601 datetime",
            "updated_at": "ISO8601 datetime",
            "message_count": "number"
          }
        ]
      },
      "getConversation": {
        "method": "GET",
        "path": "/api/v1/chat/{conversation_id}",
        "auth": true,
        "statusCode": 200,
        "params": {
          "conversation_id": "string (uuid)"
        },
        "response": {
          "id": "string (uuid)",
          "title": "string | null",
          "created_at": "ISO8601 datetime",
          "messages": [
            {
              "id": "string (uuid)",
              "role": "user | assistant",
              "content": "string",
              "created_at": "ISO8601 datetime",
              "citations": []
            }
          ]
        }
      },
      "deleteConversation": {
        "method": "DELETE",
        "path": "/api/v1/chat/{conversation_id}",
        "auth": true,
        "statusCode": 204,
        "params": {
          "conversation_id": "string (uuid)"
        },
        "response": null
      }
    },
    "documents": {
      "upload": {
        "method": "POST",
        "path": "/api/v1/documents/upload",
        "auth": true,
        "statusCode": 202,
        "request": {
          "contentType": "multipart/form-data",
          "body": {
            "file": "File (pdf | docx | txt, max 50MB)"
          }
        },
        "response": {
          "id": "string (uuid)",
          "name": "string",
          "type": "pdf | docx | txt",
          "status": "pending | processing | indexed | failed",
          "version": "number",
          "source": "string | null",
          "file_size": "number (bytes) | null",
          "created_at": "ISO8601 datetime",
          "updated_at": "ISO8601 datetime"
        }
      },
      "list": {
        "method": "GET",
        "path": "/api/v1/documents",
        "auth": true,
        "statusCode": 200,
        "query": {
          "page": "number (default: 1, min: 1)",
          "page_size": "number (default: 20, min: 1, max: 100)"
        },
        "response": {
          "items": [
            {
              "id": "string (uuid)",
              "name": "string",
              "type": "pdf | docx | txt",
              "status": "pending | processing | indexed | failed",
              "version": "number",
              "source": "string | null",
              "file_size": "number | null",
              "created_at": "ISO8601 datetime",
              "updated_at": "ISO8601 datetime"
            }
          ],
          "total": "number",
          "page": "number",
          "page_size": "number"
        }
      },
      "getById": {
        "method": "GET",
        "path": "/api/v1/documents/{doc_id}",
        "auth": true,
        "statusCode": 200,
        "params": {
          "doc_id": "string (uuid)"
        },
        "response": {
          "id": "string (uuid)",
          "name": "string",
          "type": "pdf | docx | txt",
          "status": "pending | processing | indexed | failed",
          "version": "number",
          "source": "string | null",
          "file_size": "number | null",
          "created_at": "ISO8601 datetime",
          "updated_at": "ISO8601 datetime"
        }
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/v1/documents/{doc_id}",
        "auth": true,
        "statusCode": 204,
        "params": {
          "doc_id": "string (uuid)"
        },
        "response": null
      },
      "reindex": {
        "method": "POST",
        "path": "/api/v1/documents/reindex",
        "auth": true,
        "statusCode": 200,
        "request": {
          "body": {
            "document_id": "string (uuid)"
          }
        },
        "response": {
          "id": "string (uuid)",
          "name": "string",
          "type": "pdf | docx | txt",
          "status": "pending | processing | indexed | failed",
          "version": "number",
          "source": "string | null",
          "file_size": "number | null",
          "created_at": "ISO8601 datetime",
          "updated_at": "ISO8601 datetime"
        }
      }
    },
    "admin": {
      "dashboard": {
        "method": "GET",
        "path": "/api/v1/admin/dashboard",
        "auth": true,
        "role": "admin",
        "statusCode": 200,
        "response": {
          "total_users": "number",
          "total_documents": "number",
          "total_conversations": "number",
          "total_messages": "number",
          "documents_by_status": {
            "pending": "number",
            "processing": "number",
            "indexed": "number",
            "failed": "number"
          }
        }
      },
      "jobs": {
        "method": "GET",
        "path": "/api/v1/admin/jobs",
        "auth": true,
        "role": "admin",
        "statusCode": 200,
        "response": {
          "active": "object (Celery active tasks)",
          "reserved": "object (Celery queued tasks)"
        }
      }
    }
  },
  "errors": {
    "400": "Bad Request — dữ liệu không hợp lệ",
    "401": "Unauthorized — thiếu hoặc token hết hạn",
    "403": "Forbidden — không đủ quyền (cần role admin)",
    "404": "Not Found — resource không tồn tại",
    "409": "Conflict — email đã đăng ký",
    "413": "Payload Too Large — file > 50MB",
    "415": "Unsupported Media Type — file không phải pdf/docx/txt",
    "500": "Internal Server Error — lỗi server"
  }
}