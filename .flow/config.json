{
  "_comment": "Profile production: than trong. Tier 2 rong, auto tat.",
  "auto_mode": {
    "enabled": true,
    "max_tier": 1,
    "_comment": "Codebase dang chay that: khong tu chay tiep, moi task xong deu dung lai."
  },
  "limits": {
    "max_subagent_depth": 2,
    "max_parallel_coders": 3,
    "max_fix_attempts": 3,
    "wait_window_seconds": 90,
    "_comment": "max_fix_attempts: agent sua test fail qua so lan nay thi dung va bao nguoi. wait_window_seconds: moi lan cho duyet chi cho ngan the nay roi tra quyen ve, tranh bi harness giet."
  },
  "tier_rules": {
    "2": {
      "label": "Bat buoc ban duyet",
      "paths": [
        "**/migrations/**",
        "**/migration/**",
        "**/alembic/**",
        "**/prisma/**",
        "**/auth/**",
        "**/authentication/**",
        "**/authorization/**",
        "**/permission*/**",
        "**/payment*/**",
        "**/billing/**",
        "**/checkout/**",
        "**/subscription*/**",
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*",
        "**/secrets*",
        "**/credentials*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "package.json",
        "**/package.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "package-lock.json",
        "requirements.txt",
        "pyproject.toml",
        "poetry.lock",
        "Pipfile",
        "go.mod",
        "Cargo.toml",
        "Dockerfile",
        "**/Dockerfile",
        "docker-compose*.yml",
        "docker-compose*.yaml",
        "**/.github/workflows/**",
        "**/terraform/**",
        "**/*.tf",
        "**/k8s/**",
        "**/helm/**",
        "**/nginx*",
        "**/*.service",
        "**/schema.sql",
        "**/schema.prisma",
        "**/models/**"
      ],
      "commands": [
        "git push",
        "git reset --hard",
        "git clean",
        "git rebase",
        "git filter",
        "rm -rf",
        "rm -fr",
        "sudo",
        "chmod 777",
        "mkfs",
        "dd if=",
        "npm publish",
        "pnpm publish",
        "yarn publish",
        "twine upload",
        "cargo publish",
        "npm install",
        "npm i ",
        "pnpm add",
        "yarn add",
        "pip install",
        "poetry add",
        "cargo add",
        "docker push",
        "docker run",
        "kubectl",
        "helm ",
        "terraform apply",
        "terraform destroy",
        "psql",
        "mysql ",
        "mongo ",
        "redis-cli",
        "prisma migrate",
        "alembic upgrade",
        "aws ",
        "gcloud ",
        "az ",
        "vercel deploy",
        "fly deploy",
        "heroku",
        "curl -X POST",
        "curl -X PUT",
        "curl -X DELETE",
        "wget "
      ],
      "keywords": [
        "drop table",
        "truncate",
        "delete from",
        "alter table",
        "api_key",
        "api-key",
        "secret_key",
        "private_key",
        "access_token"
      ]
    },
    "0": {
      "label": "Tu chay, khong can bao",
      "paths": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/tests/**",
        "**/test/**",
        "**/__tests__/**",
        "**/*.md",
        "docs/**",
        "**/docs/**",
        "README*",
        "CHANGELOG*",
        "**/*.css",
        "**/*.scss",
        "**/*.stories.*",
        ".flow/**",
        "**/.flow/**"
      ],
      "commands": [
        "ls",
        "cat",
        "grep",
        "rg ",
        "find ",
        "git status",
        "git diff",
        "git log",
        "npm test",
        "pnpm test",
        "yarn test",
        "pytest",
        "go test",
        "cargo test",
        "npm run lint",
        "pnpm lint",
        "eslint",
        "prettier",
        "ruff",
        "black",
        "mypy",
        "tsc"
      ],
      "keywords": []
    }
  },
  "default_tier": 1,
  "tier_labels": {
    "0": "Tu chay, khong can bao",
    "1": "Tu chay roi bao cao lai",
    "2": "Bat buoc ban duyet truoc"
  },
  "gates": {
    "_comment": "Cong kiem tra bang may. De trong mot muc de bo qua no. Chay theo thu tu.",
    "install": "",
    "lint": "auto",
    "typecheck": "auto",
    "test": "auto",
    "build": ""
  },
  "notify": {
    "on_task_pass": false,
    "on_task_fail": true,
    "on_approval_needed": true,
    "on_run_done": true,
    "_comment": "Cau hinh kenh gui qua bien moi truong, xem README."
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 7788
  },
  "profile": "production",
  "approve_mode": "direct"
}