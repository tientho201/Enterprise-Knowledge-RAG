# Application
APP_NAME="Enterprise Knowledge RAG"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# ─────────────────────────────────────────────────────
# Supabase (PostgreSQL)
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string
# ─────────────────────────────────────────────────────
# Database — dùng port 6543 (PgBouncer) thay vì 5432 để tránh vượt connection limit
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─────────────────────────────────────────────────────
# AWS S3 Object Storage
# Local dev  → LocalStack: docker-compose up localstack
#              AWS_S3_ENDPOINT_URL=http://localhost:4566
#              AWS_ACCESS_KEY_ID=test / AWS_SECRET_ACCESS_KEY=test
# Production → AWS S3 thật: để trống AWS_S3_ENDPOINT_URL
# ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=documents
AWS_S3_ENDPOINT_URL=http://localhost:4566

# Redis (local hoặc Upstash)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────────────
# Qdrant Cloud
# Lấy từ: https://cloud.qdrant.io → Cluster → API Keys
# ─────────────────────────────────────────────────────
QDRANT_URL=https://[YOUR-CLUSTER-ID].qdrant.tech
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_NAME=enterprise_knowledge

# ─────────────────────────────────────────────────────
# Neo4j (Knowledge Graph — legal cross-reference retrieval)
# Local: docker-compose up neo4j
# Cloud: https://neo4j.com/cloud/aura-free
# ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

# LangSmith (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=enterprise-knowledge-rag

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Embedding (OpenAI)
# Các model hỗ trợ: text-embedding-3-small (1536 dims) | text-embedding-3-large (3072 dims) | text-embedding-ada-002 (1536 dims)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=512

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Retrieval
DENSE_TOP_K=20
GRAPH_TOP_K=20
RERANK_TOP_K=5
DENSE_WEIGHT=0.7
GRAPH_WEIGHT=0.3

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
