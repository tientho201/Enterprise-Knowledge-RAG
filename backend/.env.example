# Application
APP_NAME="Enterprise Knowledge RAG"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# ─────────────────────────────────────────────────────
# Supabase (PostgreSQL Cloud)
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string
# Chọn tab "URI" và thay [YOUR-PASSWORD]
# ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection pool — Supabase free tier giới hạn 60 connections
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis (local hoặc Upstash)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────────────
# Qdrant Cloud
# Lấy từ: https://cloud.qdrant.io → Cluster → API Keys
# ─────────────────────────────────────────────────────
QDRANT_URL=https://[YOUR-CLUSTER-ID].qdrant.tech
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_NAME=enterprise_knowledge

# MinIO (local) — hoặc thay bằng Supabase Storage / AWS S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

# LangSmith (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=enterprise-knowledge-rag

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
